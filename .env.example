NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave anon JWT do projeto, usada pelo gateway da Edge Function de imagens.
# Não é a service_role. Nunca exponha a chave privilegiada no cliente.
SUPABASE_EDGE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Marketplace — somente no servidor, nunca prefixar credenciais com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Aplicação real — usada exclusivamente com MERCADOPAGO_MODE=production.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
# Aplicação da conta fictícia de marketplace — obrigatória em sandbox, sem fallback.
MERCADOPAGO_SANDBOX_CLIENT_ID=
MERCADOPAGO_SANDBOX_CLIENT_SECRET=
MERCADOPAGO_SANDBOX_WEBHOOK_SECRET=
# Chave aleatória de 32 bytes em base64; mantenha para poder decifrar as conexões dos vendedores.
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=
MERCADOPAGO_MODE=sandbox
NEXT_PUBLIC_APP_URL=http://localhost:3000
